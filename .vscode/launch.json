{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Waqqas IDS (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "FLASK_DEBUG": "1",
        "FLASK_USE_RELOADER": "0",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      },
      "justMyCode": true
    }
  ]
}
